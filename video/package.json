{
  "name": "asl-video",
  "private": true,
  "version": "1.0.0",
  "description": "Explainer video for the sign-language-recognition project, built with Remotion",
  "scripts": {
    "studio": "remotion studio",
    "still": "remotion still",
    "render:wide": "remotion render Wide out/asl-wide.mp4 --codec h264 --crf 16",
    "render:square": "remotion render Square out/asl-square.mp4 --codec h264 --crf 16",
    "render:vertical": "remotion render Vertical out/asl-vertical.mp4 --codec h264 --crf 16",
    "render:wide-light": "remotion render WideLight out/asl-wide-light.mp4 --codec h264 --crf 16",
    "render:square-light": "remotion render SquareLight out/asl-square-light.mp4 --codec h264 --crf 16"
  },
  "dependencies": {
    "@remotion/cli": "4.0.545",
    "@remotion/google-fonts": "4.0.545",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.545"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "puppeteer-core": "^24.10.0",
    "typescript": "5.8.3"
  }
}
